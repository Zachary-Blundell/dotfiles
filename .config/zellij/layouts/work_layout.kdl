layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
          }
        children
        pane size=2 borderless=true {
            plugin location="status-bar"
        }
      }
    tab name="Notes"{
      pane {
        command "note" 
        //close_on_exit true
      }
    }
    tab name="DVC"{
      pane {
        cwd "~/Code/Defiez-votre-cerveau/dvc/" 
        command "nvim"
        //close_on_exit true
      }
    }
    tab name="SSH"{
      pane {
        cwd "~" 
        }
    }
    tab name="Shell"{
      pane {
        cwd "~" 
        }
    }
  }
