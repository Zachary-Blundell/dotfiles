#!/bin/bash

function start {
  pkill -f firedragon
  pkill -f brave
  pkill -f whatsapp-for-linux
  pkill -f signal
  pkill -f conky
  pkill -f teams
  pkill -f morgen
  nordvpn c Kansas_City
  nordvpn set killswitch on
  librewolf torrentgalaxy.to watchsomuch.to &
  qbittorrent &
}

function stop {
  pkill librewolf
  pkill qbittorrent
  nordvpn d
  nordvpn set killswitch off
}

function help {
  echo "-s | start to start and -x | stop to stop"
}

while [ "$1" != "" ]; do
  case $1 in
  -s | s | start)
    start
    exit
    ;;
  -x | x | stop)
    stop
    exit
    ;;
  -h | --help | help)
    help
    exit
    ;;
  *)
    help
    exit
    ;;
  esac
  shift
done

help
