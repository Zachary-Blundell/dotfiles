#!/usr/bin/env bash
set -euo pipefail

# -----------------------------
# Config
# -----------------------------
FLUTTER_VERSION="flutter_linux_3.29.2-stable"
DOWNLOAD_DIR="${HOME}/Downloads"

FLUTTER_URL="https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/${FLUTTER_VERSION}.tar.xz"
FLUTTER_FILE="${FLUTTER_VERSION}.tar.xz"

# Recommended install location
INSTALL_DIR="/opt/flutter"
ZSHENV_FILE="${HOME}/.zshenv"

# -----------------------------
# Colors
# -----------------------------
if [[ -t 1 ]]; then
  RED=$'\e[31m'
  GREEN=$'\e[32m'
  YELLOW=$'\e[33m'
  BLUE=$'\e[34m'
  BOLD=$'\e[1m'
  RESET=$'\e[0m'
else
  RED=""
  GREEN=""
  YELLOW=""
  BLUE=""
  BOLD=""
  RESET=""
fi

info() { echo "${BLUE}${BOLD}==>${RESET} $*"; }
success() { echo "${GREEN}${BOLD}✔${RESET}  $*"; }
warn() { echo "${YELLOW}${BOLD}⚠${RESET}  $*"; }
error() { echo "${RED}${BOLD}✖${RESET}  $*" >&2; }

# -----------------------------
# Helpers
# -----------------------------
need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    error "Missing dependency: $1"
    exit 1
  }
}

cleanup() {
  # only remove tarball (not the extracted dir)
  [[ -f "${DOWNLOAD_DIR}/${FLUTTER_FILE}" ]] && rm -f "${DOWNLOAD_DIR}/${FLUTTER_FILE}"
}
trap cleanup EXIT

# -----------------------------
# Preflight
# -----------------------------
need_cmd wget
need_cmd tar
need_cmd grep
need_cmd sudo

mkdir -p "${DOWNLOAD_DIR}"

info "Downloading Flutter SDK to ${DOWNLOAD_DIR}..."
wget -q --show-progress "${FLUTTER_URL}" -O "${DOWNLOAD_DIR}/${FLUTTER_FILE}"
success "Download complete."

info "Extracting Flutter SDK..."
# Remove any previous extracted flutter folder in Downloads to avoid merge issues
rm -rf "${DOWNLOAD_DIR}/flutter"
tar -xf "${DOWNLOAD_DIR}/${FLUTTER_FILE}" -C "${DOWNLOAD_DIR}"
success "Extracted to ${DOWNLOAD_DIR}/flutter."

info "Installing Flutter to ${INSTALL_DIR}..."
sudo rm -rf "${INSTALL_DIR}"
sudo mkdir -p "$(dirname "${INSTALL_DIR}")"
sudo mv "${DOWNLOAD_DIR}/flutter" "${INSTALL_DIR}"
success "Installed to ${INSTALL_DIR}."

info "Creating symlink /usr/local/bin/flutter -> ${INSTALL_DIR}/bin/flutter ..."
sudo ln -sf "${INSTALL_DIR}/bin/flutter" /usr/local/bin/flutter
success "Symlink created."

# Ensure PATH is updated in this running script (so flutter works right now)
export PATH="${INSTALL_DIR}/bin:${PATH}"

info "Adding Flutter to PATH in ${ZSHENV_FILE} (if needed)..."
mkdir -p "$(dirname "${ZSHENV_FILE}")"
touch "${ZSHENV_FILE}"

PATH_LINE='export PATH="/opt/flutter/bin:$PATH"'
if grep -Fq "${PATH_LINE}" "${ZSHENV_FILE}"; then
  warn "PATH entry already present in .zshenv"
else
  echo "" >>"${ZSHENV_FILE}"
  echo "# Flutter SDK" >>"${ZSHENV_FILE}"
  echo "${PATH_LINE}" >>"${ZSHENV_FILE}"
  success "Added PATH entry to .zshenv"
fi

info "Sourcing ${ZSHENV_FILE} so flutter is available..."
# shellcheck disable=SC1090
source "${ZSHENV_FILE}" || warn "Could not source .zshenv (this may be fine in non-zsh shells)."

info "Checking flutter is on PATH..."
if command -v flutter >/dev/null 2>&1; then
  success "flutter found: $(command -v flutter)"
else
  error "flutter is still not on PATH. Try: exec zsh  (or open a new terminal)."
  exit 1
fi

info "Disabling Flutter analytics..."
flutter --disable-analytics
success "Analytics disabled."

info "Running flutter doctor..."
flutter doctor

success "Flutter installation and configuration complete!"

