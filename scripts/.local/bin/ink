# :command.initialize
initialize() {
  declare -g version="0.1.1"
  set -e

  # :command.environment_variables_default
  export INK_LEDGER="${INK_LEDGER:-$HOME/.ink/ledger}"
  export WORKFLOW_HOME="${WORKFLOW_HOME:-$HOME/.ink/workflows}"
  export QUILL="${QUILL:-nvim}"

  # :command.variables
  # :variable.definition
  declare -g day_header="## $(date '+%A, %B %d')"

  # :variable.definition
  declare -g month_header="# Log for $(date '+%B %Y')"

  # :variable.definition
  declare -g year_month="$(date +%Y-%m)"

  # :variable.definition
  declare -g current_scroll="$INK_LEDGER/$year_month.md"

}

# :command.run
run() {
  # :command.globals
  declare -g long_usage=''
  declare -g -A args=()
  declare -g -A deps=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "open") ink_open_command ;;
    "add") ink_add_command ;;
    "boost") ink_boost_command ;;
    "create") ink_create_command ;;
    "edit") ink_edit_command ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  # :command.start
  command_line_args=("$@")
  initialize
  run "${command_line_args[@]}"
fi
