#!/bin/bash
CSV_FILE="$HOME/windows/Downloads/documentSearch_bluzach.csv"

if [[ ! -f "$CSV_FILE" ]]; then
  echo "❌ CSV not found: $CSV_FILE" >&2
  exit 1
fi

if [[ -z "$current_scroll" ]]; then
  echo "❌ \$current_scroll is not set" >&2
  exit 1
fi

if [[ ! -f "$current_scroll" ]]; then
  echo "❌ Target file doesn't exist: $current_scroll" >&2
  exit 1
fi

python3 - "$CSV_FILE" "$current_scroll" <<'PYEOF'
import csv, sys, re
from datetime import date

today = date.today().strftime('%B %d')

csv_file = sys.argv[1]
output_file = sys.argv[2]

def extract_location(title):
    m = re.search(r'\[([A-Z]{3}\d+\s+\d+-\d+\s+\w+)\]', title)
    if m:
        return m.group(1)
    m = re.search(r'\[([A-Z]{3}\d+\s+\S+\s+\S+)\]', title)
    if m:
        return m.group(1)
    return ""

def extract_type(title, tags):
    combined = (title + " " + tags).upper()
    if "EC2" in combined:
        return "EC2"
    if "NETWORK" in combined or "SKYNET" in combined or "REPLACE DEVICE" in combined:
        return "NETWORK"
    return "OTHER"

def extract_problem(title):
    t = title.upper()
    patterns = [
        (r'VETTING_CBP_\w+', None),
        (r'REPLACE DEVICE', 'REPLACE_DEVICE'),
        (r'TROUBLESHOOT LINKS', 'TROUBLESHOOT_LINKS'),
        (r'BCT PARTS SORTING', 'BCT_PARTS_SORTING'),
        (r'ID HANDOFF', 'ID_HANDOFF'),
        (r'UNPLUG CABLES', 'UNPLUG_CABLES'),
        (r'NOT SSHABLE', 'NOT_SSHABLE'),
        (r'PART.?RE.?IDENTIFICATION', 'PART_REIDENTIFICATION'),
        (r'ATTENUATION.THRESHOLD.BREACHED', 'ATTENUATION_THRESHOLD'),
        (r'DECOMMISSION', 'DECOMMISSION'),
    ]
    for pattern, label in patterns:
        m = re.search(pattern, t)
        if m:
            return label if label else m.group(0)
    cleaned = re.sub(r'\[.*?\]', '', title).strip()
    words = cleaned.lstrip('- ').split()[:4]
    if words:
        return '_'.join(words).upper().rstrip('_')[:30]
    return "UNKNOWN"

def extract_host(title):
    m = re.search(r'([A-Z]{2,5}\.[A-Z0-9]{8,})', title, re.IGNORECASE)
    if m:
        return m.group(1)
    m = re.search(r'(?:Replace device|on)\s+(\S+\.network)', title, re.IGNORECASE)
    if m:
        return m.group(1)
    m = re.search(r'Host:\s*(\S+)', title)
    if m:
        return m.group(1)
    return ""

# ─── Parse CSV ───
rows = []
with open(csv_file, 'r', encoding='utf-8') as f:
    reader = csv.DictReader(f)
    for row in reader:
        title = row.get('Title', '')
        tags = row.get('Tags', '')
        severity = row.get('Severity', '?')
        status = row.get('Status', '').upper()

        rows.append({
            'sev': int(severity) if severity.isdigit() else 99,
            'problem': extract_problem(title),
            'type': extract_type(title, tags),
            'status': status,
            'host': extract_host(title),
            'location': extract_location(title),
        })

rows.sort(key=lambda r: r['sev'])

# ─── Build Markdown Table ───
lines = []
lines.append("")
lines.append(f"### 📋 T.Corp Tickets {today}")
lines.append("")
lines.append("| SEV | Problem | Type | Status | Host | Location |")
lines.append("|-----|---------|------|--------|------|----------|")

for r in rows:
    lines.append(
        f"| {r['sev']} | {r['problem']} | {r['type']} | {r['status']} "
        f"| {r['host']} | {r['location']} |"
    )

lines.append("")

with open(output_file, 'a', encoding='utf-8') as f:
    f.write('\n'.join(lines))

print(f"✅ {len(rows)} tickets appended to: {output_file}", file=sys.stderr)
PYEOF

  echo "✅ Appended to: $current_scroll" >&2

  if [[ -f "$CSV_FILE" ]]; then
    rm -f $CSV_FILE
    echo "CSV $CSV_FILE deleted" >&2
  fi

}

# :command.function
ink_create_command() {

  # src/create_command.sh
  workflow_name=${args[workflowName]}

  if [[ -z "$workflow_name" ]]; then
    # workflowName not provided
    # prompt user
    while true; do
      read -rp "Workflow name: " workflow_name
      [[ -z "$workflow_name" ]] && echo "Cancelled." && exit 1

      file="$WORKFLOW_HOME/${workflow_name// /_}.md"

      if [[ -f "$file" ]]; then
        echo "Already exists: $file"
        workflow_name=""
        continue
      fi

      break
    done
  else
    file="$WORKFLOW_HOME/${workflow_name// /_}.md"

    if [[ -f "$file" ]]; then
      echo "Already exists: $file"
      exit 1
    fi
  fi

  capitalized="$(tr '[:lower:]' '[:upper:]' <<<"${workflow_name:0:1}")${workflow_name:1}"

  # The period prevents bashly from thinking that this is a comment
  cat >"$file" <<EOF
.## $capitalized

- [ ]

EOF

  echo "Created: $file"

  "$QUILL" "$file"

}

# :command.function
ink_edit_command() {

  # src/edit_command.sh
  workflow_name=${args[workflowName]}

  if [[ -z "$workflow_name" ]]; then
    # workflowName not provided
    # Just open the folder

    "$QUILL" "$WORKFLOW_HOME"

    # file=$(
    #   find "$WORKFLOW_HOME" -type f -name "*.md" -printf '%f\n' |
    #     sort |
    #     fzf --prompt="Select workflow: "
    # )
    #
    # if [[ -z "$file" ]]; then
    #   echo "No file selected."
    #   return 1
    # fi
  else
    file="$WORKFLOW_HOME/${workflow_name// /_}.md"

    if [[ ! -f "$file" ]]; then
      echo "Workflow not found: $file"

      file=$(
        find "$WORKFLOW_HOME" -type f -name "*.md" -printf '%f\n' |
          sort |
          fzf --prompt="Select workflow: "
      )

      if [[ -z "$file" ]]; then
        echo "No file selected."
        return 1
      fi
    fi

    "$QUILL" "$WORKFLOW_HOME/$file"
  fi

}

# :command.parse_requirements
parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --version | -v)
        version_command
        exit
        ;;

      --help | -h)
        long_usage=yes
        ink_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.environment_variables_filter
  # :command.environment_variables_default
  export INK_LEDGER="${INK_LEDGER:-$HOME/.ink/ledger}"
  export WORKFLOW_HOME="${WORKFLOW_HOME:-$HOME/.ink/workflows}"
  export QUILL="${QUILL:-nvim}"

  env_var_names+=("INK_LEDGER")
  env_var_names+=("WORKFLOW_HOME")
  env_var_names+=("QUILL")

  # :command.dependencies_filter
  missing_deps=
  # :dependency.filter
  if ! command -v fzf >/dev/null 2>&1; then
    printf "missing dependency: fzf\n" >&2
    printf "%s\n\n" "run 'sudo pacman -S fzf'" >&2
    missing_deps=1
  else
    deps['fzf']="$(command -v fzf | head -n1)"
  fi

  if [[ -n $missing_deps ]]; then
    exit 1
  fi

  # :command.command_filter
  action=${1:-}

  case $action in

    open | o)
      action="open"
      shift
      ink_open_parse_requirements "$@"
      shift $#
      ;;

    add | a)
      action="add"
      shift
      ink_add_parse_requirements "$@"
      shift $#
      ;;

    boost | b)
      action="boost"
      shift
      ink_boost_parse_requirements "$@"
      shift $#
      ;;

    create | c)
      action="create"
      shift
      ink_create_parse_requirements "$@"
      shift $#
      ;;

    edit | e)
      action="edit"
      shift
      ink_edit_parse_requirements "$@"
      shift $#
      ;;

    # :command.command_fallback
    *)
      action="open"
      ink_open_parse_requirements "$@"
      shift $#
      ;;

  esac

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

# :command.parse_requirements
ink_open_parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        ink_open_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.command_filter
  action="open"

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        printf "invalid argument: %s\n" "$key" >&2
        exit 1

        ;;

    esac
  done

}

# :command.parse_requirements
ink_add_parse_requirements() {
  local key

  # :command.fixed_flags_filter
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in
      --help | -h)
        long_usage=yes
        ink_add_usage
        exit
        ;;

      *)
        break
        ;;

    esac
  done

  # :command.command_filter
  action="add"

  # :command.parse_requirements_while
  while [[ $# -gt 0 ]]; do
    key="$1"
    case "$key" in

      -?*)
        printf "invalid option: %s\n" "$key" >&2
        exit 1
        ;;

      *)
        # :command.parse_requirements_case
        # :command.parse_requirements_case_simple
        # :argument.case
        if [[ -z ${args['workflow']+x} ]]; then
          args['workflow']=$1
          shift
        else
          printf "invalid argument: %s\n" "$key" >&2
          exit 1
        fi

        ;;

    esac
  done

}

