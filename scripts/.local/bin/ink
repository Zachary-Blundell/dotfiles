# :command.usage
ink_usage() {
  if [[ -n $long_usage ]]; then
    big_logo
  else
    printf "ink - Private Journal of Records. Kept in quiet service to thought and memory.\n\n"
  fi

  printf "%s\n" "Usage:"
  printf "  ink [COMMAND]\n"
  printf "  ink [COMMAND] --help | -h\n"
  printf "  ink --version | -v\n"
  echo
  # :command.usage_commands
  printf "%s\n" "Commands:"
  printf "  %s   Consult today's journal entry (default)\n" "open  "
  printf "  %s   Append a workflow to today's entry\n" "add   "
  printf "  %s   Create summary of tickets from file\n" "boost "
  printf "  %s   Compose a new workflow template\n" "create"
  printf "  %s   Revise workflows\n" "edit  "
  echo

  # :command.long_usage
  if [[ -n "$long_usage" ]]; then
    # :command.usage_options
    printf "%s\n" "Options:"

    # :command.usage_fixed_flags
    printf "  %s\n" "--help, -h"
    printf "    Show this help\n"
    echo
    printf "  %s\n" "--version, -v"
    printf "    Show version number\n"
    echo

    # :command.usage_environment_variables
    printf "%s\n" "Environment Variables:"

    # :environment_variable.usage
    printf "  %s\n" "INK_LEDGER"
    printf "    Path where journals are stored (default \"~/.ink/ledger\")\n"
    printf "    %s\n" "Default: $HOME/.ink/ledger"
    echo

    # :environment_variable.usage
    printf "  %s\n" "WORKFLOW_HOME"
    printf "    Path where workflows are stored (default \"~/.ink/workflows\")\n"
    printf "    %s\n" "Default: $HOME/.ink/workflows"
    echo

    # :environment_variable.usage
    printf "  %s\n" "QUILL"
    printf "    Editor used to consult and revise entries (default nvim)\n"
    printf "    %s\n" "Default: nvim"
    echo

  fi
}

