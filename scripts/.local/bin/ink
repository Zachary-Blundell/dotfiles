# :command.normalize_input
# :command.normalize_input_function
normalize_input() {
  local arg passthru flags
  passthru=false

  while [[ $# -gt 0 ]]; do
    arg="$1"
    if [[ $passthru == true ]]; then
      input+=("$arg")
    elif [[ $arg =~ ^(--[a-zA-Z0-9_\-]+)=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^(-[a-zA-Z0-9])=(.+)$ ]]; then
      input+=("${BASH_REMATCH[1]}")
      input+=("${BASH_REMATCH[2]}")
    elif [[ $arg =~ ^-([a-zA-Z0-9][a-zA-Z0-9]+)$ ]]; then
      flags="${BASH_REMATCH[1]}"
      for ((i = 0; i < ${#flags}; i++)); do
        input+=("-${flags:i:1}")
      done
    elif [[ "$arg" == "--" ]]; then
      passthru=true
      input+=("$arg")
    else
      input+=("$arg")
    fi

    shift
  done
}

# :command.inspect_args
inspect_args() {
  local k

  if ((${#args[@]})); then
    readarray -t sorted_keys < <(printf '%s\n' "${!args[@]}" | sort)
    echo args:
    for k in "${sorted_keys[@]}"; do
      echo "- \${args[$k]} = ${args[$k]}"
    done
  else
    echo args: none
  fi

  if ((${#deps[@]})); then
    readarray -t sorted_keys < <(printf '%s\n' "${!deps[@]}" | sort)
    echo
    echo deps:
    for k in "${sorted_keys[@]}"; do
      echo "- \${deps[$k]} = ${deps[$k]}"
    done
  fi

  if ((${#env_var_names[@]})); then
    readarray -t sorted_names < <(printf '%s\n' "${env_var_names[@]}" | sort)
    echo
    echo "environment variables:"
    for k in "${sorted_names[@]}"; do
      echo "- \$$k = ${!k:-}"
    done
  fi
}

# :command.user_lib
# src/lib/add_day_section.sh
add_day_section() {

  local day
  day=$(date '+%d')

  if grep -q "^$day_header" "$current_scroll"; then
    echo "Today's section already exists."
  else
    cat >>"$current_scroll" <<EOF

$day_header
$(cal | sed "s/\b$day\b/[$day]/")
\`\`\`
$(curl -sS 'wttr.in/paris/?T' | head --lines=7)
\`\`\`
$(date +%R) log started
EOF

    collect_todos

  fi
}

# src/lib/ascii_art.sh
#!/usr/bin/env bash

# cat /home/zaiquiri/Code/Ink/src/lib/big_logo.txt
# cat /home/zaiquiri/Code/Ink/src/lib/small_logo.txt
# -----------------------------
# Colors
# -----------------------------
YELLOW=$'\e[33m'
RESET=$'\e[0m'
WHITE=$'\e[37m'
WHITE_BOLD=$'\e[1;37m'
PURPLE=$'\e[38;5;91m'

big_logo() {
  local YELLOW=$'\e[33m'
  local RESET=$'\e[0m'
  local WHITE=$'\e[37m'
  local WHITE_BOLD=$'\e[1;37m'
  local PURPLE=$'\e[38;5;91m'

  echo "${YELLOW}                                                   .---."
  echo "                                                  /  .  \\"
  echo "                                                  \_/|   |"
  echo "                                                     |  /|"
  echo "  .----------------------------------------------------' |"
  echo " /  .-.                                                  |"
  echo "|  /   \    ${PURPLE}~~~~ ~~~~~~ ~~~~~~~~~ ~~~${RESET}   ${WHITE_BOLD} (\`/\ ${YELLOW}           |"
  echo "| |\_.  |   ${PURPLE}~~~~~~~~~~         ~~~~~~${RESET}  ${WHITE_BOLD}  \`=\/\  ${YELLOW}         |"
  echo "|\|  | /|   ${PURPLE}~~~ ~~~~~~~~~~~~${RESET}            ${WHITE_BOLD}  \`=\/\ ${YELLOW}         |"
  echo "| \`---' |   ${PURPLE}~~~~~~ ~~~~~~~ ~~~~~ ~~~~${RESET}   ${WHITE_BOLD}   \`=\/  ${YELLOW}        |"
  echo "|       |   ${PURPLE}~~~~~ ~~~~~~~~~~~~ ~~~~~~${RESET}        ${PURPLE}_${WHITE_BOLD}\\${PURPLE}___${YELLOW}       |"
  echo "|       |                                     ${PURPLE}) (${YELLOW}       /"
  echo "|       |-----------------------------------${PURPLE}( ${WHITE}Ink${PURPLE} )${YELLOW}----'"
  echo "\       |                                    ${PURPLE}\___/${YELLOW}"
  echo " \     /"
  echo "  \`---'${RESET}"
}

small_logo() {
  echo "               (\`/\        "
  echo " __________    \`=\/\       "
  echo "()__________)   \`=\/\      "
  echo "  \ ~~~~~~~~ \   \`=\/      "
  echo "   \ ~~~~     \    _\___   "
  echo "    \ ~~~~~~   \    ) (    "
  echo "     \__________\ ( Ink )  "
  echo "    ()___________) \___/   "
}

# src/lib/collect_todos.sh
#!/bin/bash

# move-todos.sh
# Moves incomplete and in-progress TODOs to the end of a markdown file
collect_todos() {

  FILE="$current_scroll"

  if [ ! -f "$FILE" ]; then
    echo "Error: File '$FILE' not found."
    exit 1
  fi

  # Pattern matches: - [ ] (incomplete) and - [-] or - [/] (in progress)
  PATTERN='^\s*- \[[ /\-]\]'

  # Extract matching lines
  grep -E "$PATTERN" "$FILE" >/tmp/todos_extracted.tmp

  # Check if any TODOs were found
  if [ ! -s /tmp/todos_extracted.tmp ]; then
    echo "No incomplete/in-progress TODOs found."
    rm -f /tmp/todos_extracted.tmp
    exit 0
  fi

  # Remove those lines from the original file
  grep -vE "$PATTERN" "$FILE" >/tmp/todos_remaining.tmp

  # Rebuild: original content (minus TODOs) + separator + extracted TODOs
  {
    cat /tmp/todos_remaining.tmp
    echo ""
    echo "TODOs"
    echo "---"
    echo ""
    cat /tmp/todos_extracted.tmp
  } >"$FILE"

  # Report
  COUNT=$(wc -l </tmp/todos_extracted.tmp)
  echo "Moved $COUNT TODO(s) to the end of $FILE"

  # Cleanup
  rm -f /tmp/todos_extracted.tmp /tmp/todos_remaining.tmp
}

# src/lib/colors.sh
enable_auto_colors() {
  if [[ -z ${NO_COLOR+x} && ! -t 1 ]]; then
    NO_COLOR=1
  fi
}

print_in_color() {
  local color="$1"
  shift
  if [[ "${NO_COLOR:-}" == "" ]]; then
    printf "$color%b\e[0m\n" "$*"
  else
    printf "%b\n" "$*"
  fi
}

red() { print_in_color "\e[31m" "$*"; }
green() { print_in_color "\e[32m" "$*"; }
yellow() { print_in_color "\e[33m" "$*"; }
blue() { print_in_color "\e[34m" "$*"; }
magenta() { print_in_color "\e[35m" "$*"; }
cyan() { print_in_color "\e[36m" "$*"; }
black() { print_in_color "\e[30m" "$*"; }
white() { print_in_color "\e[37m" "$*"; }

bold() { print_in_color "\e[1m" "$*"; }
underlined() { print_in_color "\e[4m" "$*"; }
bold_underlined() { print_in_color "\e[1;4m" "$*"; }

red_bold() { print_in_color "\e[1;31m" "$*"; }
green_bold() { print_in_color "\e[1;32m" "$*"; }
yellow_bold() { print_in_color "\e[1;33m" "$*"; }
blue_bold() { print_in_color "\e[1;34m" "$*"; }
magenta_bold() { print_in_color "\e[1;35m" "$*"; }
cyan_bold() { print_in_color "\e[1;36m" "$*"; }
black_bold() { print_in_color "\e[1;30m" "$*"; }
white_bold() { print_in_color "\e[1;37m" "$*"; }

red_underlined() { print_in_color "\e[4;31m" "$*"; }
green_underlined() { print_in_color "\e[4;32m" "$*"; }
yellow_underlined() { print_in_color "\e[4;33m" "$*"; }
blue_underlined() { print_in_color "\e[4;34m" "$*"; }
magenta_underlined() { print_in_color "\e[4;35m" "$*"; }
cyan_underlined() { print_in_color "\e[4;36m" "$*"; }
black_underlined() { print_in_color "\e[4;30m" "$*"; }
white_underlined() { print_in_color "\e[4;37m" "$*"; }

# src/lib/create_scroll.sh
create_scroll() {
  echo "creating $INK_LEDGER if need be"
  mkdir -p "$INK_LEDGER"

  if [[ ! -f "$current_scroll" ]]; then
    touch "$current_scroll"
    echo "Created scroll of the month: $current_scroll"
  else
    echo "Scroll already exists: $current_scroll"
  fi

  # Add header only if missing
  if ! grep -qF "$month_header" "$current_scroll"; then
    tmp_file=$(mktemp)

    {
      echo "$month_header"
      echo
      echo "## Todo $(date +%B)"
      echo
      echo "- [ ] Monthly Finding"
      echo
      cat "$current_scroll"
    } >"$tmp_file"

    mv "$tmp_file" "$current_scroll"
    echo "Inserted month header"
  fi
}

# :command.command_functions
# :command.function
ink_open_command() {

  # src/open_command.sh
  create_scroll

  add_day_section

  cd $INK_LEDGER && cd .. && "$QUILL" "$current_scroll"

}

# :command.function
ink_add_command() {

  # src/add_command.sh
  # name of the file provided by user
  workflow=${args[workflow]}

  if [[ -z "$workflow" ]]; then
    echo "testing: workflow not provided"
    echo "testing: prompt user"
    workflow=$(
      find "$WORKFLOW_HOME" -type f -name "*.md" |
        fzf --prompt="Append workflow: "
    )
    [[ -z "$workflow" ]] && echo "No selection." && exit 1
  else
    workflow="$WORKFLOW_HOME/$workflow.md"
  fi

  [[ ! -f "$workflow" ]] && echo "Not found: $workflow" && exit 1

  {
    echo ""
    cat "$workflow"
  } >>"$current_scroll"

  echo "Appended: $(basename "$workflow") → $(basename "$current_scroll")"

  "$QUILL" "$current_scroll"

}

