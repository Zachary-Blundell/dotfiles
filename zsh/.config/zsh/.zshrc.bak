# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

if [[ -f "/opt/homebrew/bin/brew" ]] then # If you're using macOS, you'll want this enabled
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Set the directory we want to store zinit and plugins
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

# Download Zinit, if it's not there yet
if [ ! -d "$ZINIT_HOME" ]; then
   mkdir -p "$(dirname $ZINIT_HOME)"
   git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi

# Source/Load zinit
source "${ZINIT_HOME}/zinit.zsh"

# Add in Powerlevel10k
zinit ice depth=1; zinit light romkatv/powerlevel10k

# Add in zsh plugins
# The big 3
zinit light zsh-users/zsh-syntax-highlighting
zinit light zsh-users/zsh-completions
zinit light zsh-users/zsh-autosuggestions

zinit light Aloxaf/fzf-tab # allows fzf for tab completions

# Add in snippets
zinit snippet OMZL::git.zsh
zinit snippet OMZP::git
zinit snippet OMZP::sudo
zinit snippet OMZP::archlinux
zinit snippet OMZP::command-not-found

# Load completions
autoload -Uz compinit && compinit

zinit cdreplay -q # used by zinit to replay all cashed completions

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh # checks for the existence of a p10k do zshell file and then sources

# Keybindings
# These will only cycle history for stuff that matches what you have already started typing
bindkey '^p' history-search-backward 
bindkey '^n' history-search-forward
# bindkey '^[w' kill-region
# bindkey -e # Emacs mode# These will only cycle history for stuff that matches what you have already started typing
bindkey -v  # Vi mocde

# History
HISTSIZE=5000 # the number of commands we want to be saved inside of our history 
HISTFILE=~/.zsh_history # sets the file that's used to store all of our historical commands 
SAVEHIST=$HISTSIZE # needs to be the same size as hist size 
HISTDUP=erase # erase any duplicates inside of our history file 
setopt appendhistory # append any commands to the history file rather than overwriting
setopt sharehistory # share our Command history across all zshell sessions at the same time
setopt hist_ignore_space # This allows to you # prevent a command from being written to the history file by adding a space before it
# No duplicates in the history
setopt hist_ignore_all_dups 
setopt hist_save_no_dups 
setopt hist_ignore_dups 
setopt hist_find_no_dups 

# Completion styling
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}' # make upper or lower match
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}" # add some colors to the completion
zstyle ':completion:*' menu no                                              # remove the defualt zsh menu so we can use fzf
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath' # add path previews
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'ls --color $realpath' 

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^x^e' edit-command-line

# Shell integrations
eval "$(fzf --zsh)" # fuzzy finding on our reverse search
# can be invoked using ctrl-r
eval "$(zoxide init --cmd cd zsh)"

# -----------------------------------------------------
# Load modular configarion
# -----------------------------------------------------

if [ -d $ZDOTDIR/zshrc ]; then
  for f in $ZDOTDIR/zshrc/*; do
    if [ -f $f ]; then
      source $f
    fi
  done
  else
    echo "Error: Could not find $ZDOTDIR/zshrc directory"
fi

# To customize prompt, run `p10k configure` or edit ~/.config/zsh/.p10k.zsh.
[[ ! -f ~/.config/zsh/.p10k.zsh ]] || source ~/.config/zsh/.p10k.zsh
## Exports might get added here it is best to move them to ~/.config/zsh/.zshenv
